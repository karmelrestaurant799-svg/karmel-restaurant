# Copy this file to .env.local for local development, and add the same keys in
# Vercel -> Project -> Settings -> Environment Variables (Production + Preview).
# Never commit real values. Step-by-step setup for every service: DEPLOYMENT.md
#
# Comments sit on their own lines on purpose: some tools that import .env files
# treat "KEY=value # comment" differently.

# --- Database (required) -----------------------------------------------------
# Neon Postgres. Use the pooled string (host contains "-pooler") for the app.
# For `npx prisma db push` use the direct string (pooling off) and pass it in
# the command itself, so you never point it at the wrong database by accident.
DATABASE_URL=

# --- Auth.js (required) ------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# http://localhost:3000 locally; the real https:// address in production, with
# no trailing slash. It is used in password-reset and accept/decline email links.
NEXTAUTH_URL=http://localhost:3000

# --- Google sign-in (optional; leave empty to disable) ------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Facebook sign-in (optional; leave empty to disable) ----------------------
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Email: Gmail SMTP (required to send any email) ---------------------------
# Verification codes, password resets and reservation emails. Without these the
# app still runs but logs "email NOT sent".
# GMAIL_USER is the full address; GMAIL_APP_PASSWORD is a 16-character Google
# App Password (needs 2-Step Verification), entered without spaces.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Gmail normally replaces the From address with GMAIL_USER, so this is mostly cosmetic.
EMAIL_FROM="Karmel Café & Restaurant <your-address@gmail.com>"
# Inbox that receives every new-reservation notification.
ADMIN_EMAIL=

# --- Firebase: phone-number OTP at signup -------------------------------------
# Client config (public; Firebase Console > Project settings > General > Your apps).
# These four are baked in at BUILD time: if NEXT_PUBLIC_FIREBASE_API_KEY is missing
# or malformed, `next build` fails while prerendering /register.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Admin SDK (server-only secrets; Project settings > Service accounts > Generate new private key).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the literal \n sequences from the downloaded JSON; the app converts them
# to real newlines at runtime.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Upstash Redis: rate limiting (set these on any live site) ----------------
# Throttles login, registration and OTP attempts. If they are missing the app
# still starts, but rate limiting is silently OFF. If Upstash rejects the
# credentials, requests are allowed and a warning is logged.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Data-retention cleanup cron (GDPR storage limitation) --------------------
# Secures /api/cron/cleanup; Vercel sends it as a Bearer token to its cron job.
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Days an unverified account is kept before deletion (default 7).
UNVERIFIED_ACCOUNT_RETENTION_DAYS=7
# Months a reservation is kept before deletion (default 24).
RESERVATION_RETENTION_MONTHS=24

# --- Translations: DeepL (required for non-German languages) ------------------
# Free keys end in ":fx". Without a key the language switcher falls back to German.
DEEPL_API_KEY=
# Protects the /api/translate route (the app itself never calls it; only an
# admin session or this secret can). Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# --- SMS: Twilio (optional; leave empty to skip reservation texts) ------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM_NUMBER=

# --- Legal pages: /impressum and /datenschutz (fill in before going live) -----
# Anything left empty falls back to a placeholder or a default shown on the page.
# Have the final texts checked by a German lawyer or a service like eRecht24.
OPERATOR_NAME=
CONTENT_RESPONSIBLE=
COMMERCIAL_REGISTER=
VAT_ID=
# Shown on both pages. Default: kontakt@karmel-restaurant.de. Must be a mailbox the client owns.
CONTACT_EMAIL=
# Default: Vercel Inc., 340 S Lemon Ave #4133, Walnut, CA 91789, USA
HOSTING_PROVIDER=
# Default: Neon/PostgreSQL
DATABASE_PROVIDER=
# Default: 30
LOG_RETENTION_DAYS=30
# Set to exactly "true" only if the business takes part in consumer dispute resolution.
PARTICIPATES_IN_DISPUTE_RESOLUTION=false
